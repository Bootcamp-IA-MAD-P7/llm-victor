# Copia este archivo como .env para cambiar la configuración local. No contiene secretos.
FRONTEND_PORT=5173
API_PORT=8000
QDRANT_PORT=6333

# Se calculan a partir de los puertos; defínelas solo si necesitas otro valor.
# VITE_API_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:5173

# Groq
GROQ_API_KEY=
DEFAULT_MODEL_GROQ=llama-3.1-8b-instant

# Catálogo de modelos de texto que la web ofrece: pares "id|etiqueta" separados por comas.
TEXT_MODELS=llama-3.1-8b-instant|Llama 3.1 8B Instant

# OpenRouter (fallback opcional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
