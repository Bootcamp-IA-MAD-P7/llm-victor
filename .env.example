# Copia este archivo como .env para cambiar la configuración local. No contiene secretos.
FRONTEND_PORT=5173
API_PORT=8000
QDRANT_PORT=6333

# Se calculan a partir de los puertos; defínelas solo si necesitas otro valor.
# VITE_API_URL es obligatoria al construir la web para producción (docs/ARCHITECTURE.md §9).
# VITE_API_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:5173

# Groq
GROQ_API_KEY=
DEFAULT_MODEL_GROQ=openai/gpt-oss-120b

# Modelos de Groq que la web ofrece: pares "id|etiqueta" separados por comas.
TEXT_MODELS=openai/gpt-oss-120b|GPT-OSS 120B (Groq),openai/gpt-oss-20b|GPT-OSS 20B (Groq),qwen/qwen3.8-27b|Qwen 3.8 27B (Groq)

# Qdrant: el del entorno local por defecto. Para uno externo, su URL (https) y su clave.
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
# Modelos de OpenRouter que la web ofrece, con el mismo formato. Son también el fallback de Groq,
# en este orden. Usa modelos gratuitos (sufijo :free): sin él, OpenRouter cobra crédito.
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free|Nemotron 3 Super 120B (OpenRouter),nvidia/nemotron-3.5-lightning:free|Nemotron 3.5 Lightning (OpenRouter),poolside/laguna-s-2.1:free|Laguna S 2.1 (OpenRouter)
